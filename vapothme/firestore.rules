rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAuth() { return request.auth != null; }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    // Users — chacun lit le sien, admin lit tout
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAdmin() || isOwner(uid);
    }

    // Boutiques — lecture pour tous, écriture admin
    match /boutiques/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Planning — lecture pour tous, écriture admin
    match /planning/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Renforts — lecture pour tous, écriture admin
    match /renforts/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Notes — lecture pour tous, écriture admin
    match /notes/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Congés — lecture admin, employé lit les siens, tout le monde peut créer
    match /conges/{id} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin();
    }

    // Notifications — chacun lit les siennes, admin lit tout, système crée
    match /notifications/{id} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }
  }
}
